#!/bin/bash
# Octop (native) — post-uninstall callback
# Based on the uninstall wizard choice: on complete deletion, clean up the data-share user data; when keeping data, do nothing.
# Regardless of whether data is deleted, clean up the privileges written at install time (sudoers) and any leftover desktop services.
set -uo pipefail

# Remove the passwordless sudo rule written at install time (install_callback wrote it as root, and here it is deleted as root too;
# the NOPASSWD authorization for octop-native must not remain after uninstall).
rm -f /etc/sudoers.d/octop-native 2>/dev/null || true
echo "[octop-native] passwordless sudo rule removed" > "${TRIM_TEMP_LOGFILE:-/dev/null}" 2>&1 || true

# Remove the octop / octop-cli commands registered on PATH at install time
rm -f /usr/local/bin/octop /usr/local/bin/octop-cli 2>/dev/null || true
echo "[octop-native] commands removed: octop / octop-cli" > "${TRIM_TEMP_LOGFILE:-/dev/null}" 2>&1 || true

# Stop and disable any leftover virtual desktop systemd units (in case the user did not uninstall the desktop in the UI before uninstalling).
if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
    systemctl disable octop-desktop-xvnc octop-desktop-openbox octop-desktop-session 2>/dev/null || true
    systemctl stop octop-desktop-xvnc octop-desktop-openbox octop-desktop-session 2>/dev/null || true
    systemctl reset-failed octop-desktop-xvnc octop-desktop-openbox octop-desktop-session 2>/dev/null || true
    systemctl daemon-reload 2>/dev/null || true
fi

if [ "${wizard_delete_data:-no}" = "yes" ]; then
    DATA_DIR="${TRIM_DATA_SHARE_PATHS:-}"
    DATA_DIR="${DATA_DIR%%:*}"
    if [ -n "$DATA_DIR" ] && [ -d "$DATA_DIR" ]; then
        rm -rf "$DATA_DIR" 2>/dev/null || true
        echo "[octop-native] user data deleted: $DATA_DIR" > "${TRIM_TEMP_LOGFILE:-/dev/null}" 2>&1 || true
    fi
fi

exit 0
