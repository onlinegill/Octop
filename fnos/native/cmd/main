#!/bin/bash
#
# Octop (native) — lifecycle management
# Runs directly as a process on the FnOS host (not Docker), listening on 0.0.0.0:8089.
# start:  start Octop (setsid in the background, write the PID file); if the port is not ready it fails and writes out the reason
# stop:   kill the process tree and release 8089; SIGKILL on timeout. If start is killed midway it is also reaped.
# status: the PID is alive or 8089 is still listening (to avoid showing "stopped" when the wrapper is dead but an orphan Python process still holds the port)
#

set -uo pipefail

_OCTOP_COMMON="$(dirname "$0")/common.sh"
[ -f "$_OCTOP_COMMON" ] || _OCTOP_COMMON="/var/apps/octop-native/cmd/common.sh"
[ -f "$_OCTOP_COMMON" ] && source "$_OCTOP_COMMON"

APPDEST="${TRIM_APPDEST:-/var/apps/octop-native}"
PKGVAR="${TRIM_PKGVAR:-/var/apps/octop-native/var}"
LOG_FILE="${PKGVAR}/info.log"
PID_FILE="${PKGVAR}/octop.pid"
PORT="${OCTOP_PORT:-8089}"
BIN="$APPDEST/bin/octop"
START_WAIT_SECS="${OCTOP_START_WAIT_SECS:-90}"

if [ -n "${TRIM_DATA_SHARE_PATHS:-}" ]; then
    DATA_DIR="${TRIM_DATA_SHARE_PATHS%%:*}"
else
    DATA_DIR="${APPDEST}/shares/octop-native/data"
fi

log_msg() { echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"; }

port_ready() {
    nc -z 127.0.0.1 "$PORT" 2>/dev/null && return 0
    (exec 3<>/dev/tcp/127.0.0.1/"$PORT") 2>/dev/null && return 0
    return 1
}

run_as_service() {
    if id octop-native >/dev/null 2>&1 && command -v runuser >/dev/null 2>&1; then
        runuser -u octop-native -- "$@"
    else
        "$@"
    fi
}

# Start the service in the background: prefer setsid so the whole process tree
# shares one process group, which lets stop kill it all at once.
# $! is the session leader (runuser or the launcher); bin/octop then execs into Python.
run_as_service_bg() {
    if id octop-native >/dev/null 2>&1 && command -v runuser >/dev/null 2>&1; then
        if command -v setsid >/dev/null 2>&1; then
            setsid runuser -u octop-native -- "$@" >> "${LOG_FILE}" 2>&1 &
        else
            runuser -u octop-native -- "$@" >> "${LOG_FILE}" 2>&1 &
        fi
    elif command -v setsid >/dev/null 2>&1; then
        setsid "$@" >> "${LOG_FILE}" 2>&1 &
    else
        "$@" >> "${LOG_FILE}" 2>&1 &
    fi
}

pid_alive() {
    [ -f "${PID_FILE}" ] || return 1
    pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

fail_start() {
    local reason="$1"
    local detail
    detail="$(tail -n 40 "${LOG_FILE}" 2>/dev/null || true)"
    mkdir -p "${PKGVAR}" "${DATA_DIR}" 2>/dev/null || true
    {
        echo "$reason"
        echo
        echo "---- ${LOG_FILE} ----"
        echo "$detail"
    } > "${PKGVAR}/last-error.txt" 2>/dev/null || true
    {
        echo "$reason"
        echo
        echo "---- ${LOG_FILE} ----"
        echo "$detail"
    } > "${DATA_DIR}/octop-start-error.txt" 2>/dev/null || true
    echo "[octop-native] $reason" > "${TRIM_TEMP_LOGFILE:-/dev/null}" 2>/dev/null || true
    echo "[octop-native] $reason" >&2 || true
    [ -n "$detail" ] && echo "$detail" >&2 || true
    log_msg "$reason"
    return 1
}

start_process() {
    if pid_alive; then return 0; fi
    mkdir -p "${PKGVAR}" "${DATA_DIR}"
    : >> "${LOG_FILE}"
    chmod +x "$BIN" 2>/dev/null || true
    if [ ! -f "$BIN" ]; then
        fail_start "launcher ${BIN} not found. Please reinstall the native edition."
        return 1
    fi
    if type fix_ownership_and_perms >/dev/null 2>&1; then
        fix_ownership_and_perms "$PKGVAR" "${PKGVAR}/.env" >/dev/null || true
    fi

    # A previous stop may have killed only the runuser wrapper while Python still
    # holds the port. Clean up once more here, for direct calls to start (such as
    # from the config callback) and for self-healing after checkport is disabled.
    if port_ready; then
        log_msg "port ${PORT} is still in use, cleaning up leftover processes first"
        if type free_octop_ports >/dev/null 2>&1; then
            free_octop_ports "$PORT"
        fi
        if port_ready; then
            fail_start "port ${PORT} is still in use. Please make sure no other program is using that port."
            return 1
        fi
    fi

    log_msg "Starting Octop (native) on port ${PORT} ..."

    if [ ! -f "${DATA_DIR}/.octop/octop.db" ] && [ ! -f "${DATA_DIR}/octop.db" ]; then
        log_msg "database not initialised yet, running --prepare first"
        if ! OCTOP_PORT="$PORT" OCTOP_BIND_HOST=0.0.0.0 run_as_service "$BIN" --prepare >> "${LOG_FILE}" 2>&1; then
            fail_start "first-time initialisation failed. Please open octop-start-error.txt in the data directory, or make sure \"Python 3.12\" is installed."
            return 1
        fi
    fi

    OCTOP_PORT="$PORT" OCTOP_BIND_HOST=0.0.0.0 run_as_service_bg "$BIN" --host 0.0.0.0 --port "$PORT"
    octop_pid=$!
    # Write the PID first: if FnOS kills start before the port is ready (timeout / user cancellation), stop can still find the process.
    printf "%s" "$octop_pid" > "${PID_FILE}"

    _abort_start() {
        trap - INT TERM HUP
        if [ -n "${octop_pid:-}" ]; then
            kill -TERM -- "-$octop_pid" 2>/dev/null || true
            if type octop_kill_pid_tree >/dev/null 2>&1; then
                octop_kill_pid_tree "$octop_pid" TERM
                octop_kill_pid_tree "$octop_pid" KILL
            else
                kill -KILL "$octop_pid" 2>/dev/null || true
            fi
        fi
        if type free_octop_ports >/dev/null 2>&1; then
            free_octop_ports "$PORT"
        fi
        rm -f "${PID_FILE}"
    }
    trap '_abort_start' INT TERM HUP

    local i
    for i in $(seq 1 "$START_WAIT_SECS"); do
        if port_ready; then
            trap - INT TERM HUP
            rm -f "${DATA_DIR}/octop-start-error.txt" "${PKGVAR}/last-error.txt"
            log_msg "Octop pid=$octop_pid port ${PORT} ready"
            return 0
        fi
        if ! kill -0 "$octop_pid" 2>/dev/null; then
            trap - INT TERM HUP
            rm -f "${PID_FILE}"
            fail_start "the process exited and never listened on ${PORT}. Please open octop-start-error.txt in the data directory."
            return 1
        fi
        sleep 1
    done

    _abort_start
    fail_start "did not listen on ${PORT} within ${START_WAIT_SECS} seconds. Please open octop-start-error.txt in the data directory."
    return 1
}

stop_process() {
    log_msg "Stopping Octop (native) ..."

    if [ -r "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            # With setsid, -$pid is the whole group; on failure kill runuser + Python children via the process tree.
            kill -TERM -- "-$pid" 2>/dev/null || true
            if type octop_kill_pid_tree >/dev/null 2>&1; then
                octop_kill_pid_tree "$pid" TERM
            else
                kill -TERM "$pid" 2>/dev/null || true
            fi
            local i
            for i in $(seq 1 15); do
                if ! kill -0 "$pid" 2>/dev/null && ! port_ready; then
                    break
                fi
                sleep 0.2
            done
            if kill -0 "$pid" 2>/dev/null || port_ready; then
                kill -KILL -- "-$pid" 2>/dev/null || true
                if type octop_kill_pid_tree >/dev/null 2>&1; then
                    octop_kill_pid_tree "$pid" KILL
                else
                    kill -KILL "$pid" 2>/dev/null || true
                fi
            fi
        fi
        rm -f "${PID_FILE}"
    fi

    # The PID file may hold only the runuser wrapper; the Python process after exec still holds 8089.
    # If FnOS checks the port before calling start, a leftover listener reports "port in use", but the old page can still be opened.
    if type free_octop_ports >/dev/null 2>&1; then
        free_octop_ports "$PORT"
    fi

    local i
    for i in $(seq 1 15); do
        if ! port_ready; then
            log_msg "Octop (native) stopped, port ${PORT} released"
            return 0
        fi
        sleep 0.2
    done
    log_msg "warning: port ${PORT} is still listening after stop"
    return 1
}

status() {
    # The wrapper is dead but Python still holds the port: still report as running to the App Center so the user can click stop again.
    pid_alive || port_ready
}

case $1 in
    start)  start_process ;;
    stop)   stop_process ;;
    status) status && exit 0 || exit 3 ;;
    *)      exit 1 ;;
esac
