#!/bin/bash
#
# Octop (native) — post-upgrade callback
# An upgrade reinstalls the wizard files bundled in the package (wizard/config is
# restored to the template with placeholders), so here we re-render the
# "Settings" window using the username from the existing .env, and make sure the
# octop-login.txt emergency backup exists (it does not overwrite a password the
# user already changed in the Web UI; it is only rebuilt from .env when the
# backup is missing).
#
set -euo pipefail

_OCTOP_COMMON="$(dirname "$0")/common.sh"
[ -f "$_OCTOP_COMMON" ] || _OCTOP_COMMON="/var/apps/octop-native/cmd/common.sh"
[ -f "$_OCTOP_COMMON" ] && source "$_OCTOP_COMMON"

PKGVAR="${TRIM_PKGVAR:-/var/apps/octop-native/var}"
APPDEST="${TRIM_APPDEST:-/var/apps/octop-native}"
ENV_FILE="$PKGVAR/.env"

if [ -n "${TRIM_DATA_SHARE_PATHS:-}" ]; then
    DATA_DIR="${TRIM_DATA_SHARE_PATHS%%:*}"
else
    DATA_DIR="${APPDEST}/shares/octop-native/data"
fi

ADMIN_USER="$(octop_env_get "$ENV_FILE" OCTOP_ADMIN_USERNAME)"
ADMIN_PASS="$(octop_env_get "$ENV_FILE" OCTOP_DEFAULT_PASSWORD)"
[ -n "$ADMIN_USER" ] || ADMIN_USER="admin"

if [ -n "$ADMIN_PASS" ]; then
    # Refresh the "Settings" window username
    WIZARD_TEMPLATE="$APPDEST/wizard/config.template"
    WIZARD_DIR="$(dirname "$APPDEST")/wizard"
    [ -f "$WIZARD_TEMPLATE" ] || WIZARD_TEMPLATE="${APPDEST}/../wizard/config"
    octop_render_config_wizard "$WIZARD_TEMPLATE" "$WIZARD_DIR" "$ADMIN_USER" "$ADMIN_PASS" "$DATA_DIR"
    # Rebuild from .env only when the backup is missing (if it exists, leave it
    # alone and respect a password the user changed in the Web UI)
    if [ -d "$DATA_DIR" ] && [ ! -f "${DATA_DIR}/octop-login.txt" ]; then
        octop_write_login_file "$DATA_DIR" "$ADMIN_USER" "$ADMIN_PASS" 8089
    fi
fi

exit 0
