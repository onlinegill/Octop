#!/bin/bash
#
# Octop (native) — post-install callback
#
# The install wizard only collects the administrator account that the user sets
# up (username / password confirmation; display name and email are optional).
# Credentials are written to PKGVAR/.env and octop-login.txt, for octop init on
# first start.
#
set -euo pipefail

# Shared function library (find_python312 / fix_ownership_and_perms / free_octop_ports /
# octop_generate_password / octop_validate_password / octop_write_login_file /
# octop_render_config_wizard, etc.)
# Injected at packaging time by scripts/build-fpk.sh; when running inside the
# repository this file is absent and is skipped (missing functions raise later).
_OCTOP_COMMON="$(dirname "$0")/common.sh"
[ -f "$_OCTOP_COMMON" ] || _OCTOP_COMMON="/var/apps/octop-native/cmd/common.sh"
[ -f "$_OCTOP_COMMON" ] && source "$_OCTOP_COMMON"

# Release the Octop ports (8088=Docker edition, 8089=native edition) and kill
# leftover/orphan processes to avoid port conflicts on reinstall.
free_octop_ports

PKGVAR="${TRIM_PKGVAR:-/var/apps/octop-native/var}"
APPDEST="${TRIM_APPDEST:-/var/apps/octop-native}"
mkdir -p "$PKGVAR"
ENV_FILE="$PKGVAR/.env"

# Data lives in the FnOS data-share directory and is preserved across upgrades
# (the credential fallback backup is also kept there).
if [ -n "${TRIM_DATA_SHARE_PATHS:-}" ]; then
    DATA_DIR="${TRIM_DATA_SHARE_PATHS%%:*}"
else
    DATA_DIR="${APPDEST}/shares/octop-native/data"
fi
mkdir -p "$DATA_DIR"

fail_install() {
    echo "[octop-native] $1" > "${TRIM_TEMP_LOGFILE:-/dev/null}" 2>&1 || true
    echo "[octop-native] $1" >&2 || true
    exit 1
}

if type octop_assert_native_arch >/dev/null 2>&1; then
    if ! REASON="$(octop_assert_native_arch)"; then
        fail_install "$REASON"
    fi
fi

# ---------------------------------------------------------------------------
# Parse wizard fields (the field names in wizard/install are the env var names)
# ---------------------------------------------------------------------------
ADMIN_USER="$(octop_sanitize_value "${wizard_admin_username:-}")"
ADMIN_DISPLAY="$(octop_sanitize_value "${wizard_admin_display_name:-}")"
ADMIN_EMAIL="$(octop_sanitize_value "${wizard_admin_email:-}")"
WIZARD_PASSWORD="$(octop_sanitize_value "${wizard_admin_password:-}")"
WIZARD_CONFIRM="$(octop_sanitize_value "${wizard_admin_password_confirm:-}")"

if ! ADMIN_PASS_REASON="$(octop_validate_install_fields "$ADMIN_USER" "$WIZARD_PASSWORD" "$WIZARD_CONFIRM" "$ADMIN_EMAIL" "$ADMIN_DISPLAY" 2>&1)"; then
    fail_install "$ADMIN_PASS_REASON"
fi
ADMIN_PASS="$WIZARD_PASSWORD"

{
    echo "OCTOP_PORT=8089"
    echo "OCTOP_BIND_HOST=0.0.0.0"
    echo "OCTOP_LOG_LEVEL=info"
    echo "OCTOP_ADMIN_USERNAME=${ADMIN_USER}"
    echo "OCTOP_DEFAULT_PASSWORD=${ADMIN_PASS}"
    echo "OCTOP_ADMIN_DISPLAY_NAME=${ADMIN_DISPLAY}"
    echo "OCTOP_ADMIN_EMAIL=${ADMIN_EMAIL}"
} > "$ENV_FILE"

chmod 600 "$ENV_FILE"
echo "[octop-native] configuration written: $ENV_FILE" > "${TRIM_TEMP_LOGFILE:-/dev/null}" 2>/dev/null || true

# ---------------------------------------------------------------------------
# Administrator credential emergency backup (octop-login.txt) + render the "Settings" window username.
# If the password is forgotten, recover it from octop-login.txt in the data directory; the Settings window no longer shows the password in plaintext.
# ---------------------------------------------------------------------------
octop_write_login_file "$DATA_DIR" "$ADMIN_USER" "$ADMIN_PASS" 8089
if [ -f "${DATA_DIR}/.octop/octop.db" ]; then
    octop_mark_fnos_passwd_pending "$DATA_DIR"
fi

WIZARD_TEMPLATE="$APPDEST/wizard/config.template"
WIZARD_DIR="$(dirname "$APPDEST")/wizard"
[ -f "$WIZARD_TEMPLATE" ] || WIZARD_TEMPLATE="${APPDEST}/../wizard/config"
octop_render_config_wizard "$WIZARD_TEMPLATE" "$WIZARD_DIR" "$ADMIN_USER" "$ADMIN_PASS" "$DATA_DIR"

# ---------------------------------------------------------------------------
# Fix ownership/permissions: .env and appdata are changed back to octop-native,
# so that when the service starts as octop-native, `. "$PKGVAR/.env"` does not fail with
# Permission denied (root writes files owned by root, which a low-privilege user cannot read).
# ---------------------------------------------------------------------------
fix_ownership_and_perms "$PKGVAR" "$ENV_FILE"

# Verify that Python 3.12 is present
if ! PY="$(find_python312)"; then
    echo "[octop-native] error: Python 3.12 was not found on this FnOS system." > "${TRIM_TEMP_LOGFILE:-/dev/null}" 2>&1 || true
    echo "Please go to the FnOS App Center → Developer Tools → install \"Python 3.12\", then reinstall Octop (native)." > "${TRIM_TEMP_LOGFILE:-/dev/null}" 2>&1 || true
    exit 1
fi

echo "[octop-native] Python 3.12 detected: $PY" > "${TRIM_TEMP_LOGFILE:-/dev/null}" 2>&1 || true

# ---------------------------------------------------------------------------
# Make Octop (native) work out of the box:
#   1) Set a known password (= the administrator password) for the octop-native
#      system account, for use in scenarios such as the workbench terminal.
#   2) Grant octop-native passwordless sudo (NOPASSWD).
#      Octop components such as remote desktop / browser execute
#      `sudo -n ...` as octop-native at runtime (for example
#      desktop/setup.py's install/start/resize/uninstall); if sudo requires a
#      password they fail with "a password is required".
#      This is configured once here in the install callback (running as root), so
#      that afterwards users installing the remote desktop in the UI or running
#      sudo in the workbench terminal no longer need to enter a password.
# ---------------------------------------------------------------------------
OCTOP_USER="octop-native"

# Set the octop-native login password to the wizard administrator password (skip if the account does not exist)
if id "$OCTOP_USER" >/dev/null 2>&1; then
    echo "${OCTOP_USER}:${ADMIN_PASS}" | chpasswd 2>/dev/null || true
    echo "[octop-native] login password set for ${OCTOP_USER} (same as the administrator password)" > "${TRIM_TEMP_LOGFILE:-/dev/null}" 2>&1 || true
fi

# Write the passwordless sudo rule and validate its syntax.
# This is essential for the native edition's "remote desktop / browser / workbench
# terminal" to work, so it must succeed; therefore || true is not used to fail
# silently here — if the write or validation fails the install callback returns
# non-zero, avoiding FnOS showing "installed successfully" while the feature is
# actually unusable (an earlier printf+||true combination emptied the file).
SUDOERS_FILE="/etc/sudoers.d/octop-native"
cat > "$SUDOERS_FILE" <<'EOF'
# Allow octop-native to run any command without a password (needed by the Octop remote desktop / browser / workbench terminal)
# !requiretty: Octop invokes `sudo -n ...` as an embedded subprocess and has no controlling tty;
# if the system sudoers enables requiretty by default, it must be explicitly disabled here,
# otherwise remote desktop / browser installation fails with
# "sorry, you must have a tty to run sudo".
Defaults:octop-native !requiretty
octop-native ALL=(ALL) NOPASSWD: ALL
EOF
chmod 0440 "$SUDOERS_FILE"
if command -v visudo >/dev/null 2>&1; then
    if ! visudo -c -f "$SUDOERS_FILE" >/dev/null 2>&1; then
        echo "[octop-native] error: the written sudoers file failed syntax validation, please check ${SUDOERS_FILE}" > "${TRIM_TEMP_LOGFILE:-/dev/null}" 2>&1 || true
        exit 1
    fi
fi
echo "[octop-native] passwordless sudo configured for ${OCTOP_USER}" > "${TRIM_TEMP_LOGFILE:-/dev/null}" 2>&1 || true

# ---------------------------------------------------------------------------
# Expose the official octop CLI on PATH so that after installation users can
# use the `octop` command just like the official edition (for example
# `octop --help` / `octop provider list` / `octop agent list` /
# `octop user list` / `octop user passwd` / `octop skills ...` /
# `octop backup ...`). The actual service is hosted by the FnOS App Center
# (cmd/main launches bin/octop); this CLI is only a command-line entry point.
# A smoke test is also run: registration only counts as successful if the CLI
# really executes and prints its version.
# ---------------------------------------------------------------------------
LAUNCHER="$APPDEST/bin/octop"
chmod +x "$LAUNCHER" 2>/dev/null || true

CLI_SRC="$APPDEST/bin/octop-cli"
if [ -f "$CLI_SRC" ]; then
    chmod +x "$CLI_SRC" 2>/dev/null || true
    ln -sf "$CLI_SRC" /usr/local/bin/octop-cli
    ln -sf "$CLI_SRC" /usr/local/bin/octop
    echo "[octop-native] commands registered: octop / octop-cli -> $CLI_SRC" > "${TRIM_TEMP_LOGFILE:-/dev/null}" 2>&1 || true
    # CLI smoke test (does not block installation: on failure it only warns, and the CLI still works after the first start)
    if "$CLI_SRC" version >/dev/null 2>&1; then
        echo "[octop-native] CLI smoke test passed: octop version runs correctly" > "${TRIM_TEMP_LOGFILE:-/dev/null}" 2>&1 || true
    else
        echo "[octop-native] warning: CLI smoke test failed (octop version did not run); the first start will install offline from the bundled whl, after which the CLI works." > "${TRIM_TEMP_LOGFILE:-/dev/null}" 2>&1 || true
    fi
fi

# Perform account initialisation at install time so that the App Center's start
# does not time out within 30 seconds and show only "start failed".
if [ -f "$LAUNCHER" ]; then
    echo "[octop-native] pre-initialising after install ..." >> "$PKGVAR/info.log"
    prepare_rc=0
    if id "$OCTOP_USER" >/dev/null 2>&1 && command -v runuser >/dev/null 2>&1; then
        runuser -u "$OCTOP_USER" -- "$LAUNCHER" --prepare >> "$PKGVAR/info.log" 2>&1 || prepare_rc=$?
    else
        "$LAUNCHER" --prepare >> "$PKGVAR/info.log" 2>&1 || prepare_rc=$?
    fi
    if [ "$prepare_rc" != 0 ]; then
        fail_install "first-time initialisation failed (exit code ${prepare_rc}). Please check the application log var/info.log, or make sure \"Python 3.12\" is installed."
    fi
    echo "[octop-native] pre-initialisation complete" > "${TRIM_TEMP_LOGFILE:-/dev/null}" 2>&1 || true
fi

exit 0
