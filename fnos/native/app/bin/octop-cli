#!/bin/bash
#
# octop — "official CLI" wrapper for the FnOS native edition
#
# It replicates the octop runtime environment and then calls `python -m octop.cli.main`, so all official subcommands are available:
#   octop --help
#   octop version
#   octop provider list
#   octop agent list
#   octop user list
#   ... (also init / run / config / backup / skills / update / clean, etc.)
#
# Note: the local Web service is hosted by the FnOS App Center (cmd/main launches bin/octop);
# do not run `octop run` manually (it would fight the FnOS-managed instance for port 8089).
#
# This wrapper runs as octop-native to avoid creating root-owned data files
# (the Web service itself also runs as octop-native; mixing in root causes later permission problems).
# When called as root it uses passwordless sudo; when called by other users it prompts for their own sudo password.
#
set -euo pipefail

# Shared function library (find_python312 / fix_ownership_and_perms / free_octop_ports)
# Injected at packaging time by scripts/build-fpk.sh; when running inside the repository this file is absent and is skipped (missing functions raise later).
# Note: after the FPK is unpacked, cmd/ ends up in /var/apps/octop-native/cmd (the
# management directory), while this file lives in the payload directory
# $TRIM_APPDEST/bin, so `$0/../cmd` points to a non-existent location inside the
# payload and must fall back to the real location of the outer cmd/.
_OCTOP_COMMON="$(dirname "$0")/../cmd/common.sh"
[ -f "$_OCTOP_COMMON" ] || _OCTOP_COMMON="/var/apps/octop-native/cmd/common.sh"
[ -f "$_OCTOP_COMMON" ] && source "$_OCTOP_COMMON"

APPDEST="${TRIM_APPDEST:-/var/apps/octop-native}"
PKGVAR="${TRIM_PKGVAR:-/var/apps/octop-native/var}"

# Data directory: prefer the FnOS data-share directory, otherwise fall back to the packaged directory
if [ -n "${TRIM_DATA_SHARE_PATHS:-}" ]; then
    DATA_DIR="${TRIM_DATA_SHARE_PATHS%%:*}"
else
    DATA_DIR="$APPDEST/shares/octop-native/data"
fi

mkdir -p "$DATA_DIR" "$PKGVAR"

# Load the configuration written by the install wizard (OCTOP_PORT / administrator account, etc.)
if [ -f "$PKGVAR/.env" ]; then
    set -a; . "$PKGVAR/.env"; set +a
fi

# Locate the Python 3.12 provided by the FnOS app store

if type octop_assert_native_arch >/dev/null 2>&1; then
    if ! REASON="$(octop_assert_native_arch)"; then
        echo "[octop] $REASON" >&2
        exit 1
    fi
fi

if type octop_prepend_fnos_node_path >/dev/null 2>&1; then
    octop_prepend_fnos_node_path
fi

PY="$(find_python312)" || {
    echo "error: Python 3.12 was not found. Please install the \"Python 3.12\" development tool from the FnOS App Center first." >&2
    exit 1
}

# Key environment variables: let octop find the package itself (site-packages) and your data directory
SITE_PACKAGES="$APPDEST/site-packages"
export PYTHONPATH="${SITE_PACKAGES}${PYTHONPATH:+:$PYTHONPATH}"
export HOME="$DATA_DIR"
export OCTOP_HOME="$DATA_DIR/.octop"
export OCTOP_DATA_DIR="$DATA_DIR"

# The built-in online upgrade prefers uv (pip hangs on dependency resolution for the octop-harness[all] tree).
# If the system has no uv and we are currently root, install it once (into the system Python bin, symlinked into /usr/local/bin).
if [ "$(id -u)" = "0" ] && ! command -v uv >/dev/null 2>&1; then
    "$PY" -m pip install -q --disable-pip-version-check uv 2>/dev/null || true
    if [ -x "$(dirname "$PY")/uv" ]; then
        ln -sf "$(dirname "$PY")/uv" /usr/local/bin/uv 2>/dev/null || true
    fi
fi

# FnOS FPK deployment marker + packaged site-packages path: the built-in online upgrade installs into this directory
# (the location the launcher actually loads), so restarting the service loads the new version and the upgrade really takes effect
# (see _run_fpk_upgrade in src/octop/infra/setup/self_update.py).
export OCTOP_INSTALL_MODE="fpk-native"
export OCTOP_FPK_SITE_PACKAGES="$SITE_PACKAGES"

# Fallback: if octop is not ready in the package, install offline from the bundled core whl (to avoid network access)
if ! "$PY" -c "import octop" >/dev/null 2>&1; then
    echo "[octop] no installed Octop detected, installing offline from the bundled core whl ..."
    "$PY" -m pip install --no-cache --no-index --find-links "$SITE_PACKAGES" "$SITE_PACKAGES/octop.whl" >/dev/null 2>&1 || {
        echo "[octop] offline install failed; please check the network or run manually: $PY -m pip install $SITE_PACKAGES/octop.whl" >&2
        exit 1
    }
fi

# Run as octop-native to avoid creating root-owned data files
if id octop-native >/dev/null 2>&1 && command -v sudo >/dev/null 2>&1; then
    exec sudo -u octop-native \
        PYTHONPATH="$PYTHONPATH" \
        HOME="$HOME" \
        OCTOP_HOME="$OCTOP_HOME" \
        OCTOP_DATA_DIR="$OCTOP_DATA_DIR" \
        OCTOP_INSTALL_MODE="$OCTOP_INSTALL_MODE" \
        OCTOP_FPK_SITE_PACKAGES="$OCTOP_FPK_SITE_PACKAGES" \
        "$PY" -m octop.cli.main "$@"
else
    exec "$PY" -m octop.cli.main "$@"
fi
