#!/bin/bash
#
# Octop (native) — launcher
# Runs on the FnOS host and depends on the Python 3.12 provided by the FnOS app store (no bundled Python runtime).
# The package contains only the Octop core whl + core dependency site-packages; browser/expert/skills are installed on demand by the user.
# On first start it initialises the administrator account from the .env configured by the wizard, then starts the service.
# --prepare: only performs Python / account initialisation and does not listen on a port (used by the install callback and the start-failure message).
#
set -euo pipefail

PREPARE_ONLY=0
if [ "${1:-}" = "--prepare" ]; then
    PREPARE_ONLY=1
    shift
fi

# Shared function library (find_python312 / fix_ownership_and_perms / free_octop_ports)
# Injected at packaging time by scripts/build-fpk.sh; when running inside the repository this file is absent and is skipped (missing functions raise later).
# Note: after the FPK is unpacked, cmd/ ends up in /var/apps/octop-native/cmd (the
# management directory), while this file lives in the payload directory
# $TRIM_APPDEST/bin, so `$0/../cmd` points to a non-existent location inside the
# payload and must fall back to the real location of the outer cmd/.
_OCTOP_COMMON="$(dirname "$0")/../cmd/common.sh"
[ -f "$_OCTOP_COMMON" ] || _OCTOP_COMMON="/var/apps/octop-native/cmd/common.sh"
[ -f "$_OCTOP_COMMON" ] && source "$_OCTOP_COMMON"

APPDEST="${TRIM_APPDEST:-/var/apps/octop-native}"
PKGVAR="${TRIM_PKGVAR:-/var/apps/octop-native/var}"

# Data lives in the FnOS data-share directory and is preserved across upgrades.
if [ -n "${TRIM_DATA_SHARE_PATHS:-}" ]; then
    DATA_DIR="${TRIM_DATA_SHARE_PATHS%%:*}"
else
    DATA_DIR="${APPDEST}/shares/octop-native/data"
fi

mkdir -p "$DATA_DIR" "$PKGVAR"

# Load the wizard configuration (written by install_callback / config_callback)
if [ -f "$PKGVAR/.env" ]; then
    set -a
    . "$PKGVAR/.env"
    set +a
fi

export HOME="$DATA_DIR"
export OCTOP_HOME="${DATA_DIR}/.octop"
export OCTOP_DATA_DIR="$DATA_DIR"

# Locate Python 3.12 on the FnOS system (prefer the app store install path, then PATH).
# If the App Center already has Node.js installed, add it to PATH as well, for the expert shell / npx.

if type octop_assert_native_arch >/dev/null 2>&1; then
    if ! REASON="$(octop_assert_native_arch)"; then
        echo "[octop-native] $REASON" >&2
        exit 1
    fi
fi

if type octop_prepend_fnos_node_path >/dev/null 2>&1; then
    octop_prepend_fnos_node_path
fi

PY="$(find_python312)" || {
    echo "[octop-native] error: Python 3.12 was not found." >&2
    echo "Please install the \"Python 3.12\" development tool from the FnOS App Center first, then reinstall this application." >&2
    exit 1
}

SITE_PACKAGES="$APPDEST/site-packages"
export PYTHONPATH="${SITE_PACKAGES}${PYTHONPATH:+:${PYTHONPATH}}"

# The built-in online upgrade prefers uv (pip hangs on dependency resolution for the octop-harness[all] tree).
# If the system has no uv and we are currently root, install it once (into the system Python bin, symlinked into /usr/local/bin).
if [ "$(id -u)" = "0" ] && ! command -v uv >/dev/null 2>&1; then
    "$PY" -m pip install -q --disable-pip-version-check uv 2>/dev/null || true
    if [ -x "$(dirname "$PY")/uv" ]; then
        ln -sf "$(dirname "$PY")/uv" /usr/local/bin/uv 2>/dev/null || true
    fi
fi

# FnOS FPK deployment marker + packaged site-packages path: the built-in online upgrade installs into this directory
# (the location the launcher actually loads), so restarting the service loads the new version and the upgrade really takes effect
# (see _run_fpk_upgrade in src/octop/infra/setup/self_update.py).
export OCTOP_INSTALL_MODE="fpk-native"
export OCTOP_FPK_SITE_PACKAGES="$SITE_PACKAGES"

# Fallback: if octop is not detected in the packaged site-packages (upgrade failure /
# corruption, etc.), install offline in place from the bundled core whl so the user
# does not have to download it over the network.
if ! "$PY" -c "import octop" >/dev/null 2>&1; then
    echo "[octop-native] no installed Octop detected, installing offline from the bundled core whl ..."
    "$PY" -m pip install --no-cache --no-index --find-links "$SITE_PACKAGES" "$SITE_PACKAGES/octop.whl" >/dev/null 2>&1 || {
        echo "[octop-native] offline install failed; please check the network or run manually: $PY -m pip install $SITE_PACKAGES/octop.whl" >&2
        exit 1
    }
fi

OCTOP_PORT="${OCTOP_PORT:-8089}"
OCTOP_LOG_LEVEL="${OCTOP_LOG_LEVEL:-info}"
OCTOP_BIND_HOST="${OCTOP_BIND_HOST:-0.0.0.0}"

mkdir -p "$OCTOP_HOME"

octop_cmd() {
    "$PY" -m octop.cli.main "$@"
}

# Initialise the administrator account on first start (only when the database does not exist yet).
# Password fallback chain (fix for issue #502):
#   1) .env has no password written (old package / abnormal install) → generate a random password automatically;
#   2) init is rejected by the password policy (e.g. the hard-coded Octop123 of older versions is on the
#      weak-password blacklist and reports "password is too common") → retry once with a random strong password;
#   3) after the retry, write the value back to .env and to the octop-login.txt fallback backup, keeping the
#      credentials consistent so the user never loses the password.
if [ ! -f "$OCTOP_HOME/octop.db" ]; then
    echo "[octop-native] first start, initialising the administrator account ..."
    INIT_PW="${OCTOP_DEFAULT_PASSWORD:-}"
    if [ -z "$INIT_PW" ]; then
        INIT_PW="$(octop_generate_password 16)"
        echo "[octop-native] no initial password configured in .env; a random password has been generated automatically."
    fi
    if ! octop_cmd init --yes \
        --admin-username "${OCTOP_ADMIN_USERNAME:-admin}" \
        --admin-password "$INIT_PW" \
        ${OCTOP_ADMIN_DISPLAY_NAME:+--admin-display-name "$OCTOP_ADMIN_DISPLAY_NAME"}; then
        echo "[octop-native] the initial password did not pass the application password policy (too weak or too common); retrying with a random password ..."
        INIT_PW="$(octop_generate_password 16)"
        octop_cmd init --yes \
            --admin-username "${OCTOP_ADMIN_USERNAME:-admin}" \
            --admin-password "$INIT_PW" \
            ${OCTOP_ADMIN_DISPLAY_NAME:+--admin-display-name "$OCTOP_ADMIN_DISPLAY_NAME"} || {
            echo "[octop-native] error: failed to initialise the administrator account, please check the log above." >&2
            exit 1
        }
    fi
    # When the password in .env differs from the one actually in effect (random retry /
    # auto-generated path), write it back to .env so that the "Settings" window display,
    # octop-cli password changes and other paths all receive the real credentials.
    if [ "$INIT_PW" != "${OCTOP_DEFAULT_PASSWORD:-}" ]; then
        octop_env_set "$PKGVAR/.env" OCTOP_DEFAULT_PASSWORD "$INIT_PW"
        export OCTOP_DEFAULT_PASSWORD="$INIT_PW"
    fi
    octop_write_login_file "$DATA_DIR" "${OCTOP_ADMIN_USERNAME:-admin}" "$INIT_PW" "${OCTOP_PORT:-8089}"
    if [ -n "${OCTOP_ADMIN_EMAIL:-}" ]; then
        octop_cmd user set-email "${OCTOP_ADMIN_USERNAME:-admin}" "$OCTOP_ADMIN_EMAIL" || true
    fi
    : > "${OCTOP_HOME}/.fnos-wizard-password-applied"
    rm -f "${OCTOP_HOME}/.fnos-apply-wizard-password"
elif [ -f "${OCTOP_HOME}/.fnos-apply-wizard-password" ] && [ -n "${OCTOP_DEFAULT_PASSWORD:-}" ]; then
    echo "[octop-native] applying the pending wizard password ..."
    octop_cmd user passwd "${OCTOP_ADMIN_USERNAME:-admin}" --password "$OCTOP_DEFAULT_PASSWORD" || true
    if [ -n "${OCTOP_ADMIN_EMAIL:-}" ]; then
        octop_cmd user set-email "${OCTOP_ADMIN_USERNAME:-admin}" "$OCTOP_ADMIN_EMAIL" || true
    fi
    : > "${OCTOP_HOME}/.fnos-wizard-password-applied"
    rm -f "${OCTOP_HOME}/.fnos-apply-wizard-password"
fi

if [ "$PREPARE_ONLY" = 1 ]; then
    echo "[octop-native] initialisation complete"
    exit 0
fi

echo "[octop-native] starting Octop, $OCTOP_BIND_HOST:$OCTOP_PORT ..."
exec "$PY" -m octop.cli.main run --host "$OCTOP_BIND_HOST" --port "$OCTOP_PORT" --log-level "${OCTOP_LOG_LEVEL}"
