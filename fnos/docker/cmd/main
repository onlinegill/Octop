#!/bin/bash
#
# Octop — FnOS lifecycle management (docker-project)
# start/stop are managed automatically by the fnOS App Center based on the
# docker-project in config/resource; start still restores the .env used for
# compose interpolation first (copied back from @appdata after target/ is
# replaced), and points the volumes at TRIM_DATA_SHARE_PATHS so that a restart
# does not go through first-time setup again.
#

_OCTOP_COMMON="$(dirname "$0")/common.sh"
[ -f "$_OCTOP_COMMON" ] || _OCTOP_COMMON="/var/apps/octop/cmd/common.sh"
[ -f "$_OCTOP_COMMON" ] && source "$_OCTOP_COMMON"

FILE_PATH="${TRIM_APPDEST}/docker/docker-compose.yaml"
ENV_FILE="${TRIM_APPDEST:-/var/apps/octop/target}/docker/.env"

ensure_persist() {
    if type octop_prepare_docker_persist >/dev/null 2>&1; then
        octop_prepare_docker_persist "$ENV_FILE" >/dev/null
    fi
}

is_docker_running() {
    DOCKER_NAME=""
    if [ -f "$FILE_PATH" ]; then
        DOCKER_NAME=$(grep "container_name" "$FILE_PATH" | awk -F ':' '{print $2}' | xargs)
    fi
    if [ -n "$DOCKER_NAME" ]; then
        docker inspect "$DOCKER_NAME" 2>/dev/null | grep -q "\"Status\": \"running\"," || return 1
        return 0
    fi
    return 1
}

case $1 in
start)
    ensure_persist
    # docker app is started by appcenter
    exit 0
    ;;
stop)
    # docker app is stopped by appcenter
    exit 0
    ;;
status)
    if is_docker_running; then
        exit 0
    else
        exit 3
    fi
    ;;
*)
    exit 1
    ;;
esac
