#!/bin/bash
# Octop — pre-uninstall callback
# Based on the uninstall wizard's wizard_delete_data choice:
#   - Keep data: do not clean TRIM_DATA_SHARE_PATHS (usually /volX/@appshare/octop/data).
#   - Delete everything: clean up the data-share in uninstall_callback.
# Also release the Octop ports (8088=Docker edition, 8089=native edition) so that
# leftover processes do not hold the port after uninstall.
set -euo pipefail

# Shared function library (find_python312 / fix_ownership_and_perms / free_octop_ports)
# Injected at packaging time by scripts/build-fpk.sh; when running inside the repository this file is absent and is skipped (missing functions raise later).
_OCTOP_COMMON=""$(dirname "$0")/common.sh""
[ -f "$_OCTOP_COMMON" ] && source "$_OCTOP_COMMON"

log() { echo "[octop] $1" > "${TRIM_TEMP_LOGFILE:-/dev/null}" 2>/dev/null || true; }



free_octop_ports

if [ "${wizard_delete_data:-no}" = "yes" ]; then
    log "user chose to delete data completely; the data-share will be cleaned up in uninstall_callback"
else
    log "user chose to keep data; the data-share will be preserved"
fi

exit 0
