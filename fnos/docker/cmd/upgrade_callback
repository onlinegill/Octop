#!/bin/bash
#
# Octop — post-upgrade callback
# An upgrade reinstalls the wizard files bundled in the package (wizard/config is
# restored to the template with placeholders), so here we re-render the
# "Settings" window using the username from the existing docker/.env, and make
# sure the octop-login.txt emergency backup exists (it does not overwrite a
# password the user already changed in the Web UI; it is only rebuilt from .env
# when the backup is missing). The new image is pulled and the container rebuilt
# by the App Center.
#
set -euo pipefail

_OCTOP_COMMON="$(dirname "$0")/common.sh"
[ -f "$_OCTOP_COMMON" ] || _OCTOP_COMMON="/var/apps/octop/cmd/common.sh"
[ -f "$_OCTOP_COMMON" ] && source "$_OCTOP_COMMON"

ENV_FILE="${TRIM_APPDEST:-/var/apps/octop/target}/docker/.env"
# An upgrade replaces target/, so first restore .env from @appdata, then remount
# the data-share and migrate the old directory.
DATA_DIR="$(octop_prepare_docker_persist "$ENV_FILE")"
mkdir -p "$DATA_DIR"

ADMIN_USER="$(octop_env_get "$ENV_FILE" OCTOP_ADMIN_USERNAME)"
ADMIN_PASS="$(octop_env_get "$ENV_FILE" OCTOP_DEFAULT_PASSWORD)"
ADMIN_DISPLAY="$(octop_env_get "$ENV_FILE" OCTOP_ADMIN_DISPLAY_NAME)"
ADMIN_EMAIL="$(octop_env_get "$ENV_FILE" OCTOP_ADMIN_EMAIL)"
[ -n "$ADMIN_USER" ] || ADMIN_USER="admin"

if [ -n "$ADMIN_PASS" ]; then
    # Refresh the "Settings" window username
    WIZARD_TEMPLATE="${TRIM_APPDEST:-/var/apps/octop/target}/wizard/config.template"
    WIZARD_DIR="$(dirname "${TRIM_APPDEST:-/var/apps/octop/target}")/wizard"
    [ -f "$WIZARD_TEMPLATE" ] || WIZARD_TEMPLATE="${TRIM_APPDEST:-/var/apps/octop/target}/../wizard/config"
    octop_render_config_wizard "$WIZARD_TEMPLATE" "$WIZARD_DIR" "$ADMIN_USER" "$ADMIN_PASS" "$DATA_DIR"
    # Rebuild from .env only when the backup is missing (if it exists, leave it
    # alone and respect a password the user changed in the Web UI)
    if [ ! -f "${DATA_DIR}/octop-login.txt" ]; then
        octop_write_login_file "$DATA_DIR" "$ADMIN_USER" "$ADMIN_PASS" 8088
    fi
    octop_write_fnos_bootstrap "$DATA_DIR" "$ADMIN_USER" "$ADMIN_PASS" "$ADMIN_DISPLAY" "$ADMIN_EMAIL"
fi

exit 0
