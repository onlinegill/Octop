#!/bin/bash
#
# Octop — post-install callback
#
# The install wizard only collects the administrator account that the user sets
# up (username / password confirmation; display name and email are optional).
# Credentials are written to .env, the data-share bootstrap file and
# octop-login.txt, for the container's first init / password change.
#
set -euo pipefail

# Shared function library (find_python312 / fix_ownership_and_perms / free_octop_ports /
# octop_generate_password / octop_validate_password / octop_write_login_file /
# octop_render_config_wizard, etc.)
# Injected at packaging time by scripts/build-fpk.sh; when running inside the
# repository this file is absent and is skipped (missing functions raise later).
_OCTOP_COMMON="$(dirname "$0")/common.sh"
[ -f "$_OCTOP_COMMON" ] || _OCTOP_COMMON="/var/apps/octop/cmd/common.sh"
[ -f "$_OCTOP_COMMON" ] && source "$_OCTOP_COMMON"

# Release the Octop ports (8088=Docker edition, 8089=native edition) and kill
# leftover/orphan processes to avoid port conflicts on reinstall.
free_octop_ports

ENV_FILE="${TRIM_APPDEST:-/var/apps/octop/target}/docker/.env"
mkdir -p "$(dirname "$ENV_FILE")"

# Mount the FnOS data-share (TRIM_DATA_SHARE_PATHS); it is preserved across
# upgrades/restarts; the old share/ path is migrated over.
DATA_DIR="$(octop_prepare_docker_persist "$ENV_FILE")"
mkdir -p "$DATA_DIR"

fail_install() {
    echo "[octop] $1" > "${TRIM_TEMP_LOGFILE:-/dev/null}" 2>&1 || true
    echo "[octop] $1" >&2 || true
    exit 1
}

# ---------------------------------------------------------------------------
# Parse wizard fields (the field names in wizard/install are the env var names)
# ---------------------------------------------------------------------------
ADMIN_USER="$(octop_sanitize_value "${wizard_admin_username:-}")"
ADMIN_DISPLAY="$(octop_sanitize_value "${wizard_admin_display_name:-}")"
ADMIN_EMAIL="$(octop_sanitize_value "${wizard_admin_email:-}")"
WIZARD_PASSWORD="$(octop_sanitize_value "${wizard_admin_password:-}")"
WIZARD_CONFIRM="$(octop_sanitize_value "${wizard_admin_password_confirm:-}")"

if ! ADMIN_PASS_REASON="$(octop_validate_install_fields "$ADMIN_USER" "$WIZARD_PASSWORD" "$WIZARD_CONFIRM" "$ADMIN_EMAIL" "$ADMIN_DISPLAY" 2>&1)"; then
    fail_install "$ADMIN_PASS_REASON"
fi
ADMIN_PASS="$WIZARD_PASSWORD"

{
    echo "OCTOP_PORT=8088"
    echo "OCTOP_BIND_HOST=0.0.0.0"
    echo "OCTOP_LOG_LEVEL=info"
    echo "OCTOP_ADMIN_USERNAME=${ADMIN_USER}"
    echo "OCTOP_DEFAULT_PASSWORD=${ADMIN_PASS}"
    echo "OCTOP_ADMIN_DISPLAY_NAME=${ADMIN_DISPLAY}"
    echo "OCTOP_ADMIN_EMAIL=${ADMIN_EMAIL}"
    echo "TRIM_DATA_SHARE_PATHS=${DATA_DIR}"
    echo "OCTOP_DATA=${DATA_DIR}"
} > "$ENV_FILE"

chmod 600 "$ENV_FILE"
octop_persist_docker_env "$ENV_FILE"
octop_write_fnos_bootstrap "$DATA_DIR" "$ADMIN_USER" "$ADMIN_PASS" "$ADMIN_DISPLAY" "$ADMIN_EMAIL"
octop_distribute_docker_env "$ENV_FILE" "$DATA_DIR"
if [ -f "${DATA_DIR}/.octop/octop.db" ]; then
    octop_mark_fnos_passwd_pending "$DATA_DIR"
fi
echo "[octop] configuration written: $ENV_FILE (data-share=${DATA_DIR})" > "${TRIM_TEMP_LOGFILE:-/dev/null}" 2>/dev/null || true

# ---------------------------------------------------------------------------
# Credential emergency backup (octop-login.txt) + render the "Settings" window username
# ---------------------------------------------------------------------------
octop_write_login_file "$DATA_DIR" "$ADMIN_USER" "$ADMIN_PASS" 8088

WIZARD_TEMPLATE="${TRIM_APPDEST:-/var/apps/octop/target}/wizard/config.template"
WIZARD_DIR="$(dirname "${TRIM_APPDEST:-/var/apps/octop/target}")/wizard"
[ -f "$WIZARD_TEMPLATE" ] || WIZARD_TEMPLATE="${TRIM_APPDEST:-/var/apps/octop/target}/../wizard/config"
octop_render_config_wizard "$WIZARD_TEMPLATE" "$WIZARD_DIR" "$ADMIN_USER" "$ADMIN_PASS" "$DATA_DIR"

exit 0
